{
  "name": "ptt-mobile-shell",
  "version": "0.1.0",
  "private": true,
  "description": "RNOS-M3 — Capacitor shell wrapping portal.pttads.vn (PWA-first → native)",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "cap:init": "npm run build:www && npx cap add ios && npx cap add android",
    "cap:sync": "npm run build:www && cap sync",
    "cap:sync:staging": "npm run build:www && CAPACITOR_PORTAL_URL=${CAPACITOR_PORTAL_URL:-https://portal.pttads.vn} cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
