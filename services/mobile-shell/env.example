# RNOS-M3 mobile-shell — copy to .env.local (optional)
# Production WebView target (default: https://portal.pttads.vn)
CAPACITOR_PORTAL_URL=https://portal.pttads.vn

# Staging pilot
# CAPACITOR_PORTAL_URL=https://portal-staging.pttads.vn

# Universal links host (iOS Associated Domains + Android App Links)
PTT_PORTAL_UNIVERSAL_LINK_HOST=portal.pttads.vn

# --- Phase 2 store upload (copy to .env.local — never commit) ---
# APPLE_TEAM_ID=
# APP_STORE_CONNECT_API_KEY_PATH=/secure/AuthKey_XXXX.p8
# APP_STORE_CONNECT_KEY_ID=
# APP_STORE_CONNECT_ISSUER_ID=
# GOOGLE_PLAY_JSON_KEY_PATH=/secure/play-console-sa.json
# TESTFLIGHT_CHANGELOG=RNOS-M3 internal build 1

# --- Phase 4 GA release ---
