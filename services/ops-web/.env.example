# Ops web — local dev
NEXT_PUBLIC_PTT_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PTT_EMAIL_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_SEND_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_JOURNEYS_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_GATE_A_ENABLED=1
# Meta Enterprise B8 — show Alerts tab + PG inbox (backend also needs PTT_META_ALERTS_ENABLED=1)
NEXT_PUBLIC_PTT_META_ALERTS_ENABLED=0
OPS_PORT=3200
NEXT_PUBLIC_PTT_META_TRACKING_ENABLED=0
# RNOS-06 — AI Copilot on /crm/leads/[id] (0=hidden)
NEXT_PUBLIC_PTT_AI_COPILOT_ENABLED=1
# MKT-AI-04 — AI Marketing Planner tab on service delivery (0=hidden, fail-closed)
NEXT_PUBLIC_MKT_AI_PLANNER=0
# Market Research OS — hide /crm/research + Lên kế hoạch research link when 0
NEXT_PUBLIC_MARKET_RESEARCH=0
# WIN-2 — Org admin UI (off until staging UAT)
NEXT_PUBLIC_WIN_ORG_UI=0
NEXT_PUBLIC_WIN_KPI_SOLUTION=0
