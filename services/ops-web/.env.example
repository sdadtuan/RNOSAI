# Ops web — local dev
NEXT_PUBLIC_PTT_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PTT_EMAIL_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_SEND_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_JOURNEYS_ENABLED=1
NEXT_PUBLIC_PTT_EMAIL_GATE_A_ENABLED=1
# Meta Enterprise B8 — show Alerts tab + PG inbox (backend also needs PTT_META_ALERTS_ENABLED=1)
NEXT_PUBLIC_PTT_META_ALERTS_ENABLED=0
OPS_PORT=3200
NEXT_PUBLIC_PTT_META_TRACKING_ENABLED=0
# RNOS-06 — AI Copilot on /crm/leads/[id] (0=hidden)
NEXT_PUBLIC_PTT_AI_COPILOT_ENABLED=1
# MKT-AI-04 — AI Marketing Planner tab on service delivery (0=hidden, fail-closed)
NEXT_PUBLIC_MKT_AI_PLANNER=0
# Content Marketing OS — sidebar + Content Board tab (0=hidden)
NEXT_PUBLIC_CONTENT_MARKETING=0
# Optional FE copy of PTT_CONTENT_MARKETING_SLUGS; empty = list all lifecycles on /crm/content-os
# NEXT_PUBLIC_CONTENT_MARKETING_SLUGS=tiep-thi-noi-dung
# Market Research OS — hide /crm/research + Lên kế hoạch research link when 0
NEXT_PUBLIC_MARKET_RESEARCH=0
# WIN — prod/staging: copy from ../../deploy/ops-web-client-flags.env (local dev needs =1 for Org/Onboard menu)
NEXT_PUBLIC_WIN_ORG_UI=1
NEXT_PUBLIC_WIN_KPI_SOLUTION=1
NEXT_PUBLIC_WIN_PERMISSION_SETS=1
NEXT_PUBLIC_WIN_SIMULATOR=1
NEXT_PUBLIC_WIN_BREAK_GLASS=1
NEXT_PUBLIC_WIN_SCOPE_PILOT=1
NEXT_PUBLIC_WIN_SSO=1
NEXT_PUBLIC_WIN_FIELD_ABAC=1
NEXT_PUBLIC_WIN_POLICY_OPA=1
NEXT_PUBLIC_WIN_CPL_DIGEST=1
NEXT_PUBLIC_WIN_PAYSLIP_PORTAL=1
NEXT_PUBLIC_WIN_LEAVE_LITE=1
