# PTT CRM API — MKT-AI planner flags (see docs/runbooks/mkt-ai-planner-delivery-sop.md)
# PTT_MKT_AI_PLANNER_ENABLED=1
# PTT_MKT_AI_PLANNER_SLUGS=meta-lead-gen
# PTT_MKT_AI_MODEL=gpt-4o-mini

# Solution AI — webhook agent is primary; LLM key is the optional fallback.
# Do not commit secrets. Names only below.
# PTT_SOLUTION_AGENT_WEBHOOK_URL=
# PTT_SOLUTION_AGENT_SECRET=
# PTT_CRM_API_PUBLIC_URL=http://127.0.0.1:3000
# AI_LLM_API_KEY=
# PTT_AI_LLM_API_KEY=
# PTT_AI_LLM_MODEL=gpt-4o-mini
# PTT_AI_LLM_TIMEOUT_MS=60000
# PTT_AI_LLM_BASE_URL=


# Content Marketing OS (see docs/superpowers/plans/2026-08-09-content-marketing-coding-milestones.md)
# PTT_CONTENT_MARKETING_ENABLED=1
# PTT_CONTENT_MARKETING_FE=1
# PTT_CONTENT_MARKETING_SLUGS=tiep-thi-noi-dung
# PTT_CONTENT_MARKETING_AI_ENABLED=1
# PTT_CONTENT_MARKETING_APPROVAL_REQUIRED=1

# Portal CRM inbox — background Facebook poll (requires PTT_PORTAL_CRM_CARE=1)
# PTT_PORTAL_INBOX_POLL=1
# PTT_PORTAL_INBOX_POLL_MS=45000
# PTT_META_WEBHOOK_VERIFY_TOKEN=
