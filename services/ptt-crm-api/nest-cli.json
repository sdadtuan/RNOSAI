{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "staff-permissions/rbac-admin-catalog.json", "watchAssets": true },
      { "include": "leads-funnel/**/*.json", "watchAssets": true },
      { "include": "marketing-ai-planner/playbooks/**/*.json", "watchAssets": true },
      { "include": "deal-room/**/*.json", "watchAssets": true }
    ]
  }
}
