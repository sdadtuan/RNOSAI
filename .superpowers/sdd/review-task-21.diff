+    ).toBe('weights_sum');
+    expect(
+      amSettingsWeightsError({
+        kpi_delivery: 30,
+        engagement: 20,
+        financial: 20,
+        satisfaction: 15,
+        contract_support: 15,
+      }),
+    ).toBeNull();
+  });
