+  bands_json JSONB NOT NULL DEFAULT '{"healthy":[80,100],"watch":[60,79],"at_risk":[40,59],"critical":[0,39]}',
+  quota_accounts_per_am INTEGER NOT NULL DEFAULT 40,
+  watch_ends_on_days INTEGER NOT NULL DEFAULT 30,
