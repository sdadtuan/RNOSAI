+  let i = startAt;
+  if (sql.includes('$teams')) {
+    sql = sql.replaceAll('$teams', `$${i++}`);
+    params.push(fragment.params[0]);
+    if (sql.includes('$staff')) {
+      sql = sql.replaceAll('$staff', `$${i++}`);
