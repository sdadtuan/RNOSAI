+    if (!into) {
+      setFormError('Cần khách đích');
+      return;
+    }
+    setBusy(true);
+    setFormError('');
+    try {
+      await mergeAmAccount(token, agencyClientId, into);
+      setMergeHint('');
+      setDrawer(null);
+      push('Đã hợp nhất', 'success');
