+            <label className="am-field">
+              <span>Kênh ưu tiên</span>
+              <select value={preferChannel} onChange={(e) => setPreferChannel(e.target.value)}>
+                {AM_CONTACT_CHANNELS.map((row) => (
+                  <option key={row.value} value={row.value}>
+                    {row.label}
+                  </option>
+                ))}
+              </select>
