+  const currentId = currentRaw ? Number(currentRaw) : null;
+  if (nextId === currentId || (nextId == null && currentId == null)) return {};
+  if (!canAssign) return { error: 'assign_required' };
+  return { owner_staff_id: nextId };
+}
