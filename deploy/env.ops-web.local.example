# Ops web local / staging
NEXT_PUBLIC_PTT_API_URL=http://127.0.0.1:3000
OPS_PORT=3200

# RNOS-41 / M1 — PWA lead care (set 0 to disable install banner + SW)
NEXT_PUBLIC_PWA_ENABLED=1

# Nest staff-auth (set on ptt-crm-api process)
