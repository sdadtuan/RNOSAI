# RNOS-01 / RNOS-40 — AI Intelligence env (staging / prod pilot)
# Copy to vault / .env — NEVER commit secrets.

# Feature gate
PTT_AI_COPILOT_ENABLED=0
PTT_AI_PILOT_USER_IDS=

# LLM (vault only in prod)
PTT_AI_LLM_PROVIDER=openai
PTT_AI_LLM_MODEL=gpt-4o-mini
PTT_AI_LLM_TIMEOUT_MS=8000
AI_LLM_API_KEY=

# Compliance (prod: 0 bắt buộc)
PTT_AI_LOG_PII=0
PTT_AI_LOG_PROMPTS=0

# Scoring
PTT_AI_SCORE_ASYNC=1
# Worker consumer calls Nest (RNOS-08)
# PTT_CRM_API_URL=http://127.0.0.1:3000
# PTT_CRM_INTERNAL_KEY=

# Summarize (RNOS-03)
# PTT_AI_SUMMARIZE_RATE_LIMIT_PER_MIN=20
# PTT_AI_SUMMARIZE_MIN_TEXT=50

# PostgreSQL (required for RNOS-01 apply)
# DATABASE_URL=postgresql://ptt:ptt_dev@127.0.0.1:5433/rnosaidb
