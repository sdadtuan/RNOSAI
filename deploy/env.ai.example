# RNOS-40 — AI Intelligence env (Nest ptt-crm-api + ops-web build)
# Copy vào VPS EnvironmentFile hoặc vault — KHÔNG commit secrets.
# Runbook: docs/runbooks/ai-service-operations.md
# Gate:    bash scripts/rnos40_gate.sh

# ─────────────────────────────────────────────────────────────
# Feature gate (BR-AI-04 pilot cohort)
# ─────────────────────────────────────────────────────────────
# 0 = copilot API trả 503 trên guarded routes; ops-web ẩn panel
PTT_AI_COPILOT_ENABLED=0

# Optional allowlist — staff JWT `sub` (UUID hoặc numeric id stub local).
# Rỗng = mọi staff có cap CRM + copilot flag ON đều dùng được (staging).
# Prod pilot: 5–8 user — xem deploy/pilot-cohort.example.json
PTT_AI_PILOT_USER_IDS=

# ops-web build-time (phải khớp Nest khi bật pilot UI)
# NEXT_PUBLIC_PTT_AI_COPILOT_ENABLED=0
# NEXT_PUBLIC_PTT_AI_PILOT_USER_IDS=

# RNOS-41 — PWA lead care (manifest + service worker). Set 0 to disable SW registration.
# NEXT_PUBLIC_PWA_ENABLED=1

# ─────────────────────────────────────────────────────────────
# LLM provider (vault prod)
# ─────────────────────────────────────────────────────────────
PTT_AI_LLM_PROVIDER=openai
PTT_AI_LLM_MODEL=gpt-4o-mini
PTT_AI_LLM_TIMEOUT_MS=8000
# Alias được hỗ trợ: PTT_AI_LLM_API_KEY
AI_LLM_API_KEY=

# ─────────────────────────────────────────────────────────────
# Compliance & audit (prod BẮT BUỘC 0)
# ─────────────────────────────────────────────────────────────
PTT_AI_LOG_PII=0
PTT_AI_LOG_PROMPTS=0

# ─────────────────────────────────────────────────────────────
# Scoring async (RNOS-08)
# ─────────────────────────────────────────────────────────────
PTT_AI_SCORE_ASYNC=1
# Worker gọi Nest score endpoint — set trên ptt-worker / job handler
# PTT_CRM_API_URL=http://127.0.0.1:3000
# PTT_CRM_INTERNAL_KEY=

# ─────────────────────────────────────────────────────────────
# Summarize / recommendation rate limit (RNOS-03 / RNOS-07)
# ─────────────────────────────────────────────────────────────
PTT_AI_SUMMARIZE_RATE_LIMIT_PER_MIN=20
PTT_AI_SUMMARIZE_MIN_TEXT=50

# ─────────────────────────────────────────────────────────────
# PostgreSQL (RNOS-01 DDL)
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://ptt:PASS@127.0.0.1:5432/ptt_crm

# ─────────────────────────────────────────────────────────────
# Auth (staging/prod — required for pilot cohort guard)
# ─────────────────────────────────────────────────────────────
# PTT_CRM_INTERNAL_KEY=change-me-internal-key
# PTT_STAFF_JWT_SECRET=change-me-staff-jwt-min-32-chars
# PTT_STAFF_ALLOW_STUB=1
# PTT_STAFF_STUB_USERS=staff@demo.local:demo12345:1:1:Pilot

# ─────────────────────────────────────────────────────────────
# Rollback nhanh (runbook §8)
# ─────────────────────────────────────────────────────────────
# 1. PTT_AI_COPILOT_ENABLED=0 → restart ptt-crm-api + ops-web
# 2. Model: đổi PTT_AI_LLM_MODEL → restart API
# 3. Prompt: UPDATE ai_prompts SET is_active … (§9.2 runbook)
# Drill: bash scripts/rnos40_rollback_drill.sh
