# RNOSAI — local development ONLY (không dùng ptt_agency / port 5432 dự án khác)
# VPS production: /var/www/rnosai · DATABASE_URL=...@127.0.0.1:5433/rnosai
# Usage: source deploy/env.local.example

export DATABASE_URL=postgresql://ptt:ptt_dev@127.0.0.1:5433/rnosaidb
export POSTGRES_USER=ptt
export POSTGRES_PASSWORD=ptt_dev
export POSTGRES_DB=rnosaidb
export RNOSAI_PG_PORT=5433
export RNOSAI_APP_ROOT=/var/www/rnosai

# Nest API / workers
export PTT_LEADS_READ_SOURCE=pg

# CẤM apply DDL RNOSAI lên DB khác — scripts sẽ từ chối nếu URL chứa /ptt_agency
