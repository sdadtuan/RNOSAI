# M2 — Portal PWA + Web Push on VPS staging (portal.pttads.vn)
# Usage on VPS:
#   cd /var/www/rnosai
#   git pull
#   APPLY=0 ./scripts/m2_portal_pwa_staging_cutover.sh
#   APPLY=1 ./scripts/m2_portal_pwa_staging_cutover.sh
#
# Local gate only:
#   bash scripts/staging_m2_portal_pwa_kickoff.sh

# ── VPS paths (override on dev machine) ──
export PTT_ENV_FILE="${PTT_ENV_FILE:-/var/www/rnosai/.env}"
export DATABASE_URL="${DATABASE_URL:-postgresql://ptt:CHANGE_ME@127.0.0.1:5433/rnosaidb}"

# ── Portal public URL (staging uses same host as prod pilot) ──
export M2_PORTAL_PUBLIC_URL="${M2_PORTAL_PUBLIC_URL:-https://portal.pttads.vn}"
export NEXT_PUBLIC_PTT_API_URL="${NEXT_PUBLIC_PTT_API_URL:-https://portal.pttads.vn}"
export NEXT_PUBLIC_PWA_ENABLED=1

# ── Nest push (generate once: ./scripts/generate_portal_vapid_keys.sh --write-env /var/www/rnosai/.env) ──
export PTT_PORTAL_PUSH_ENABLED=1
export PTT_PORTAL_VAPID_SUBJECT="${PTT_PORTAL_VAPID_SUBJECT:-mailto:portal-push@pttads.vn}"
# PTT_PORTAL_VAPID_PUBLIC_KEY=
# PTT_PORTAL_VAPID_PRIVATE_KEY=
export PTT_PORTAL_PUSH_TEST_IN_PROD=0

# ── CORS ──
export PTT_PORTAL_CORS_ORIGINS="${PTT_PORTAL_CORS_ORIGINS:-https://portal.pttads.vn}"

# ── Gate / E2E (local only) ──
export PORTAL_E2E_URL="${PORTAL_E2E_URL:-http://127.0.0.1:3100}"
export RNOS_M2_ENV="$PWD/deploy/env.staging-m2-portal-pwa-vps.example"
