# Copy → services/ptt-crm-api/.env (local only, không commit, không VPS)
# DB local — KHÔNG dùng rs.pttads.vn / DATABASE prod

DATABASE_URL=postgresql://ptt:ptt_dev@127.0.0.1:5433/rnosaidb
PTT_LEADS_READ_SOURCE=pg
PTT_LEADS_WRITE_SOURCE=pg
PTT_LEADS_WRITE_ENABLED=1
PTT_LEADS_READ_UPSTREAM=nest
PTT_LEAD_REPLICA_SYNC=0

PORT=3000
CRM_API_PORT=3000

PTT_STAFF_JWT_SECRET=dev-staff-jwt-change-me-min-32-chars-local-only
PTT_STAFF_STUB_USERS=staff@demo.local:demo123:staff-demo-1:1:Demo Staff
PTT_OPS_CORS_ORIGINS=http://127.0.0.1:3200,http://localhost:3200,http://192.168.1.90:3200

PTT_CRM_API_AUTH_DISABLED=0
PTT_WEBHOOKS_NEST_ENABLED=0
PTT_JOBS_ENABLED=0
PTT_WEBHOOK_V1_ENQUEUE=0

# Không set PTT_LOCAL_API_PROXY_TARGET / không trỏ API prod
