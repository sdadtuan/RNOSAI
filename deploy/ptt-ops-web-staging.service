[Unit]
Description=PTT Ops — Next.js staging (/test prefix, does not affect production)
After=network.target ptt-crm-api.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/rnosai/current/ops-web-staging
Environment=NODE_ENV=production
Environment=PORT=3201
EnvironmentFile=-/var/www/rnosai/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
