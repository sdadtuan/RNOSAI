# M1 — PWA Staff Lead Care (RNOS-41) staging / local kickoff
# Usage:
#   set -a && source deploy/env.staging-m1-pwa.example && set +a
#   bash scripts/staging_m1_pwa_kickoff.sh
#
# VPS staging (rs staging host): merge vào .env + rebuild ops-web:
#   export NEXT_PUBLIC_PWA_ENABLED=1
#   export NEXT_PUBLIC_PTT_API_URL=https://rs-staging.pttads.vn  # hoặc URL staging thật

# ── Inherit local DB (rnosaidb :5433) ──
source deploy/env.local.example

# ── ops-web build-time ──
export NEXT_PUBLIC_PTT_API_URL="${NEXT_PUBLIC_PTT_API_URL:-http://127.0.0.1:3000}"
export NEXT_PUBLIC_PWA_ENABLED=1
export OPS_PORT=3200

# ── Gate / E2E ──
export OPS_E2E_URL="${OPS_E2E_URL:-http://127.0.0.1:3200}"
export OPS_E2E_API_URL="${OPS_E2E_API_URL:-http://127.0.0.1:3000}"
export RNOS41_ENV="$PWD/deploy/env.staging-m1-pwa.example"

# Nest stub staff (E2E only — không dùng prod)
export PTT_STAFF_ALLOW_STUB=1
export PTT_STAFF_STUB_USERS="${OPS_E2E_STAFF_EMAIL:-staff@demo.local}:${OPS_E2E_STAFF_PASSWORD:-demo12345}:1:1:E2E PWA"
export PTT_STAFF_JWT_SECRET="${PTT_STAFF_JWT_SECRET:-rnos41-e2e-staff-jwt-secret-min-32-chars}"
export PTT_CRM_INTERNAL_KEY="${PTT_CRM_INTERNAL_KEY:-rnos41-e2e-internal-key}"
