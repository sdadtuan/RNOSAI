[Unit]
Description=PTT Temporal worker (Phase 3 creative approval)
After=network.target

[Service]
Type=simple
User=ptt
WorkingDirectory=/var/www/rnosai
Environment=PYTHONPATH=/var/www/rnosai
EnvironmentFile=-/etc/ptt/temporal.env
ExecStart=/var/www/rnosai/.venv/bin/python /var/www/rnosai/ptt_temporal/worker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
