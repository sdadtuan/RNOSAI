# RNOS-M3 Phase 4 — GA production (portal + native shell)
# Merge into VPS /var/www/rnosai/.env after Phase 3 sign-off

# --- Mobile GA ---
PTT_MOBILE_NATIVE_PUSH_ENABLED=1
PTT_MOBILE_MIN_VERSION=1.0.0
PTT_MOBILE_FORCE_UPDATE=0
PTT_FCM_SERVER_KEY=<vault>
# PTT_APNS_KEY_ID= ...
# PTT_APNS_TEAM_ID= ...

# --- Sentry (WebView + portal-web — tag client:capacitor-portal) ---
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=ptt-portal@1.0.0

# --- Rollback levers (Phase 4) ---
# Option A — block old app builds (keep listing):
#   PTT_MOBILE_MIN_VERSION=1.0.1
#   PTT_MOBILE_FORCE_UPDATE=1
# Option B — pull store listing: see scripts/m3_ga_rollback_pull_listing.sh

# Portal public URL (Capacitor WebView)
CAPACITOR_PORTAL_URL=https://portal.pttads.vn
