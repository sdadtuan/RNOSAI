# MKT-AI Planner — GA rollout env template (WS-P4-01 / MKTP-UC-024)
#
# Usage:
#   cp deploy/env.mkt-ai-ga.example deploy/runtime.env.mkt-ai-ga
#   # edit values, merge into deploy/runtime.env + .env on target host
#   sudo systemctl restart ptt-crm-api
#   NEXT_PUBLIC_MKT_AI_PLANNER=1 ./scripts/deploy_ops_web.sh --restart
#
# Rollback (≤5 min): set PTT_MKT_AI_PLANNER_ENABLED=0, NEXT_PUBLIC_MKT_AI_PLANNER=0, restart API + ops-web.

# ── Module master switch ──
export PTT_MKT_AI_PLANNER_ENABLED=1
export NEXT_PUBLIC_MKT_AI_PLANNER=1

# ── Pilot slug whitelist ──
# Staging GA pack: 3 slugs
export PTT_MKT_AI_PLANNER_SLUGS=meta-lead-gen,bds-lead-gen,seo-retainer
# Prod pilot (1 client): see deploy/env.mkt-ai-prod-pilot.example
# Prod GA (all slugs): leave empty or unset — API treats empty as no whitelist block

# ── Phase 1–3 feature flags ──
export PTT_MKT_AI_RAG_ENABLED=1
export PTT_MKT_AI_APPROVAL_REQUIRED=1
export PTT_MKT_AI_KPI_ALERT_ENABLED=1
export PTT_MKT_AI_PLAYBOOKS_ENABLED=1
export PTT_MKT_AI_MULTI_AGENT_ENABLED=1
export PTT_MKT_AI_GOVERNANCE_BANNER=1

# Launch QA bridge — opt-in on prod if client uses Launch QA tab
export PTT_MKT_AI_LAUNCH_QA_QUALITY_GATE=1

# ── Phase 4 depth WS-P4-02 (S2+) ──
export PTT_MKT_AI_PLAN_DEPTH_ENABLED=1
export PTT_MKT_AI_BRIEF_UPLOAD_ENABLED=1

# ── Phase 4 depth Wave 2 WS-P4-04 (MKTP-UC-027/029) ──
export PTT_MKT_AI_SCENARIO_COMPARE=1
export PTT_MKT_AI_SECTION_COMMENTS=1
export PTT_MKT_AI_EXPORT_PPTX=1

# ── Phase 4 async (WS-P4-03 — enable after worker ship) ──
# export PTT_MKT_AI_MULTI_AGENT_ASYNC=1
export PTT_MKT_AI_MULTI_AGENT_ASYNC=1

# ── Smoke / UAT on VPS ──
export PTT_API_URL=http://127.0.0.1:3000
export DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/ptt_agency
export LIFECYCLE_ID=1
export PTT_CRM_INTERNAL_KEY=replace-me-internal-key

# Seed + verify:
#   bash scripts/seed_mkt_ai_uat_lifecycle.sh
#   bash scripts/smoke_mkt_ai_multi_slug.sh
#   bash scripts/smoke_mkt_ai_plan_depth_wave2.sh
#   bash scripts/close_mkt_ai_p3_signoff.sh
