# MKT-AI Planner — Production pilot (1 client · WS-P4-01-T7 / MKTP-UC-024)
#
# Prerequisites: staging P3 sign-off PASS (close_mkt_ai_p3_signoff.sh)
#
# Usage:
#   cp deploy/env.mkt-ai-prod-pilot.example deploy/runtime.env.mkt-ai-prod-pilot
#   # Fill PILOT_* below, merge into deploy/runtime.env on prod VPS
#   MKT_AI_PILOT_LIFECYCLE_ID=123 APPLY=1 ./scripts/deploy_mkt_ai_planner_prod_pilot.sh
#
# Rollback (≤5 min):
#   bash scripts/mkt_ai_prod_pilot_rollback.sh

# ── Pilot client (REQUIRED — real lifecycle, not UAT seed) ──
export MKT_AI_PILOT_LIFECYCLE_ID=0          # e.g. 42 — onboard/deliver lifecycle
export MKT_AI_PILOT_SERVICE_SLUG=meta-lead-gen
export MKT_AI_PILOT_CLIENT_NAME="Client Pilot A"
export MKT_AI_PILOT_AM_EMAIL=am@pttads.vn
export MKT_AI_PILOT_SP_EMAIL=sp@pttads.vn

# ── Module flags (prod pilot = single slug whitelist) ──
export PTT_MKT_AI_PLANNER_ENABLED=1
export PTT_MKT_AI_PLANNER_SLUGS=meta-lead-gen
export PTT_MKT_AI_RAG_ENABLED=1
export PTT_MKT_AI_APPROVAL_REQUIRED=1
export PTT_MKT_AI_KPI_ALERT_ENABLED=1
export PTT_MKT_AI_PLAYBOOKS_ENABLED=1
export PTT_MKT_AI_MULTI_AGENT_ENABLED=1
export PTT_MKT_AI_GOVERNANCE_BANNER=1
# Opt-in: enable only if client uses Launch QA tab
export PTT_MKT_AI_LAUNCH_QA_QUALITY_GATE=0
export NEXT_PUBLIC_MKT_AI_PLANNER=1

# ── VPS / API ──
export PTT_VPS_HOST=rs.pttads.vn
export PTT_VPS_ROOT=/var/www/rnosai
export PTT_API_URL=http://127.0.0.1:3000
export NEXT_PUBLIC_PTT_API_URL=https://rs.pttads.vn
export DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/ptt_agency
export PTT_CRM_INTERNAL_KEY=replace-me-internal-key

# ── Soak window ──
export MKT_AI_PILOT_SOAK_DAYS=7

# Gate + monitor:
#   bash scripts/mkt_ai_prod_pilot_gate.sh
#   bash scripts/mkt_ai_prod_pilot_monitor.sh
# Day 7 sign-off: copy deploy/mkt-ai-prod-pilot-signoff.template.json → .local-dev/
